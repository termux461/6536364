# ---------- Telegram ----------
BOT_TOKEN=
# Comma-separated, no brackets and no quotes: 111222333,444555666
ADMIN_IDS=123456789,987654321
SUPPORT_USERNAME=support

# ---------- Infrastructure ----------
DATABASE_URL=postgresql+asyncpg://rwbot:rwbot@postgres:5432/rwbot
REDIS_URL=redis://redis:6379/0

# ---------- Webhook HTTP server ----------
# Public base URL where /webhooks/* are reachable (https, behind nginx)
# Must be https://<BOT_PUBLIC_DOMAIN> — the same host, or callbacks never arrive.
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ---------- Platega ----------
PLATEGA_API_KEY=
PLATEGA_MERCHANT_ID=
PLATEGA_WEBHOOK_SECRET=
PLATEGA_API_URL=https://app.platega.io

# ---------- YooKassa ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT_EMAIL=
# Comma-separated CIDRs, no brackets and no quotes
YOOKASSA_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32

# ---------- Remnawave (optional defaults, user supplies per order) ----------
REMNAWAVE_DEFAULT_URL=
REMNAWAVE_API_TOKEN=
# Panel API major. Empty or "auto" detects it from GET /system/metadata (v3 has that route,
# v2 does not). Pin to "v2" or "v3" only when something in front of the panel eats the probe.
REMNAWAVE_API_VERSION=auto

# ---------- Yandex Cloud (optional defaults, user supplies per order) ----------
YANDEX_CLOUD_ID=
YANDEX_FOLDER_ID=
# Full JSON of the service account authorized key (one line)
YANDEX_SERVICE_ACCOUNT_KEY=

# ---------- Security ----------
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ---------- Deployment tuning ----------
DEPLOY_MAX_ATTEMPTS=3
DEPLOY_RETRY_DELAYS=5,15,30
SSH_TIMEOUT=30
SSH_COMMAND_TIMEOUT=900
DNS_PROPAGATION_TIMEOUT=1800
CERTIFICATE_WAIT_TIMEOUT=3600
LOG_LEVEL=INFO

# --- Yandex Cloud auth ------------------------------------------------------
# Cookie auth is NOT part of the published Yandex API. The exchange endpoint is discovered
# at runtime from the domains the cookies were issued for; set the URL below only to pin a
# specific one. Set ENABLED=false to hide the method from the menu entirely.
YANDEX_COOKIE_AUTH_ENABLED=true
# Leave empty to auto-detect from the domains the cookies were issued for.
# Set it only to pin a specific endpoint.
YANDEX_COOKIE_EXCHANGE_URL=
YANDEX_COOKIE_TOKEN_FIELD=iamToken

# --- TLS without nginx (docker-compose.caddy.yml) ---------------------------
# Domain Caddy will obtain a certificate for. Must resolve to this host.
BOT_PUBLIC_DOMAIN=bot.example.com
