# --- Telegram ---
BOT_TOKEN=123456:your-telegram-bot-token
ADMIN_IDS=111111111,222222222
SUPPORT_CHAT_ID=

# --- URLs (must be public HTTPS in production, used for WebApp buttons) ---
WEBAPP_URL=https://your-domain.example/webapp
PANEL_URL=https://your-domain.example/panel
PUBLIC_BASE_URL=https://your-domain.example

# --- Database ---
POSTGRES_USER=vpnbot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vpnbot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vpnbot:change_me@postgres:5432/vpnbot

# --- Redis (FSM storage, rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Panel admin auth ---
PANEL_SECRET_KEY=change_me_random_secret
PANEL_ADMIN_LOGIN=admin
PANEL_ADMIN_PASSWORD=change_me

# --- Remnawave (default host, more can be added in panel) ---
REMNAWAVE_API_URL=https://your-remnawave-panel.example/api
REMNAWAVE_API_TOKEN=

# --- Payment providers ---
# Telegram Stars needs no extra keys (uses BOT_TOKEN)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_URL=https://pay.crypt.bot/api

# --- Misc ---
DEFAULT_LOCALE=ru
REFERRAL_BONUS_PERCENT=10
REFERRAL_SIGNUP_BONUS=0
REFERRAL_MIN_WITHDRAW=100
SUBSCRIBE_CHANNEL_ID=
LOG_LEVEL=INFO
